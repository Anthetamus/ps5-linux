[Unit]
Description=Bridge NXP IW620 wifi firmware from /boot/efi/lib to /lib/firmware
Documentation=https://github.com/ps5-linux/ps5-linux-mwifiex
# Adopted from fedora's ps5-iw620.service pattern: run LATE in boot
# (multi-user.target), after /boot/efi is mounted, before NetworkManager.
# The moal/mlan modules are blacklisted from auto-load (modprobe.d), so
# the install script copies firmware then modprobes moal in the right
# order — no race with udev-triggered autoload, no early-boot ordering
# cycle vs sysinit.target.
RequiresMountsFor=/boot/efi
Wants=systemd-udev-settle.service
After=local-fs.target systemd-udev-settle.service
Before=NetworkManager.service network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ps5-iw620-firmware-install
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
